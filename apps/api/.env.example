DATABASE_URL=postgresql://testcase_stage1:replace-locally@127.0.0.1:5432/testcase_stage1
TEST_DATABASE_URL=postgresql://testcase_stage1:replace-locally@127.0.0.1:5432/testcase_stage1_test
FILE_STORAGE_ROOT="/Users/sion/Library/Application Support/TestCaseGenerator/stage-1/files"
API_PORT=3101
# 기본은 loopback. 다른 기기에서 접속해야 하면 0.0.0.0
API_HOST=
CORS_ORIGINS=http://127.0.0.1:5173

# Local Figma iframe only: also requires NODE_ENV=development.
ALLOW_FIGMA_NULL_ORIGIN=false
# 원격으로 호스팅한 플러그인 UI의 Origin. CORS_ORIGINS와 겹치면 안 되며 운영에서는 HTTPS만 받는다.
# 로컬에서 pnpm dev:plugin:remote로 시험할 때는 http://localhost:5174
PLUGIN_UI_ORIGIN=

# 운영에서는 세션 쿠키에 Secure를 적용합니다.
NODE_ENV=development

# AI 제공자 키. 사용하는 제공자의 키만 서버 환경에 설정합니다.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# fake는 외부 호출 없이 합성 결과를 만듭니다.
AI_PROVIDER=

# 비용 동기화용 관리자 키와 범위 ID는 제공자별로 함께 설정한다.
OPENAI_ADMIN_KEY=
OPENAI_COST_PROJECT_ID=
ANTHROPIC_ADMIN_KEY=
# 기본 워크스페이스는 default를 쓴다.
ANTHROPIC_COST_WORKSPACE_ID=
