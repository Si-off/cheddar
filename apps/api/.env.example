DATABASE_URL=postgresql://cheddar_stage1:replace-locally@127.0.0.1:5432/cheddar_stage1
TEST_DATABASE_URL=postgresql://cheddar_stage1:replace-locally@127.0.0.1:5432/cheddar_stage1_test
FILE_STORAGE_ROOT="/Users/sion/Library/Application Support/Cheddar/stage-1/files"
API_PORT=3101
CORS_ORIGINS=http://127.0.0.1:5173

# Local Figma iframe only: also requires NODE_ENV=development.
ALLOW_FIGMA_NULL_ORIGIN=false

# Server-only AI credentials. Leave blank until configured locally.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_MODEL=gpt-6-luna

# Shared-DB generation capacity, including input preparation (1-8).
# Use the same value on every API process connected to this database.
AI_GENERATION_CONCURRENCY=2

# Optional provider billing sync. Both the admin key and dedicated remote scope
# are required. These IDs are provider project/workspace IDs, not Cheddar UUIDs.
OPENAI_ADMIN_KEY=
OPENAI_COST_PROJECT_ID=
ANTHROPIC_ADMIN_KEY=
# Use "default" only for Anthropic's default (null ID) workspace.
ANTHROPIC_COST_WORKSPACE_ID=
AI_COST_SYNC_INTERVAL_SECONDS=3600
