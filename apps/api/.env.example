DATABASE_URL=postgresql://cheddar_stage1:replace-locally@127.0.0.1:5432/cheddar_stage1
TEST_DATABASE_URL=postgresql://cheddar_stage1:replace-locally@127.0.0.1:5432/cheddar_stage1_test
FILE_STORAGE_ROOT="/Users/sion/Library/Application Support/Cheddar/stage-1/files"
API_PORT=3101
CORS_ORIGINS=http://127.0.0.1:5173

# Local Figma iframe only: also requires NODE_ENV=development.
ALLOW_FIGMA_NULL_ORIGIN=false

# 운영에서는 세션 쿠키에 Secure를 적용합니다.
NODE_ENV=development

# AI 제공자 키. 사용하는 제공자의 키만 서버 환경에 설정합니다.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# fake는 외부 호출 없이 합성 결과를 만듭니다. 비워 두면 단계별 모델 설정을 따릅니다.
AI_PROVIDER=
# 단계별 모델. 짧은 이름(haiku, sonnet, opus, luna, terra) 또는 anthropic:<모델>, openai:<모델>.
# 비워 두면 아래 기본값을 씁니다.
AI_MODEL_SCREENS=terra
AI_MODEL_FLOWS=terra
AI_MODEL_CASES=terra
AI_MODEL_FINISH=luna
AI_MODEL_REWRITE=terra
# 단계별 effort. low, medium, high, xhigh, max 중 하나. Claude와 GPT에 같은 값을 보냅니다.
# effort를 받지 않는 모델은 default로 두면 보내지 않습니다.
AI_EFFORT_SCREENS=low
AI_EFFORT_FLOWS=medium
AI_EFFORT_CASES=high
AI_EFFORT_FINISH=low
AI_EFFORT_REWRITE=medium

# 최초 생성, 추가 생성과 다시 작성의 서버 전체 동시 한도. 1~8, 기본 2.
AI_GENERATION_CONCURRENCY=2
# 비용 동기화용 관리자 키와 범위 ID는 제공자별로 함께 설정한다.
OPENAI_ADMIN_KEY=
OPENAI_COST_PROJECT_ID=
ANTHROPIC_ADMIN_KEY=
# 기본 워크스페이스는 default를 쓴다.
ANTHROPIC_COST_WORKSPACE_ID=
# 60~86400초. 테스트와 AI_PROVIDER=fake에서는 자동 동기화하지 않는다.
AI_COST_SYNC_INTERVAL_SECONDS=3600
