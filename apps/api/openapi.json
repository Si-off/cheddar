  "info": {
    "title": "Cheddar API",
    "description": "Local project and file API. Upload, sheet and IA schemas are contracts for subsequent stages, not implemented routes.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "ErrorDetailDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "details": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": true
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            ]
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "additionalProperties": false
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetailDto"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "PageQueryDto": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": {
            "type": "string",
            "maxLength": 256
          }
        },
        "additionalProperties": false
      },
      "CreateProjectDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 2000
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "ProjectDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 2000
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "revision",
          "createdAt",
          "updatedAt"
        ],
        "additionalProperties": false
      },
      "ProjectPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "UpdateProjectDto": {
        "type": "object",
        "properties": {
          "expectedRevision": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 2000
          }
        },
        "required": [
          "expectedRevision"
        ],
        "additionalProperties": false
      },
      "FileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "originalName": {
            "type": "string",
            "maxLength": 255
          },
          "mediaType": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "application/json"
            ]
          },
          "byteSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20971520
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "ready"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "projectId",
          "originalName",
          "mediaType",
          "byteSize",
          "sha256",
          "status",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "FilePageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FileDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "FrameInputDto": {
        "type": "object",
        "properties": {
          "figmaFileKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "figmaNodeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "width": {
            "type": "number",
            "minimum": 0.01
          },
          "height": {
            "type": "number",
            "minimum": 0.01
          },
          "imageFileId": {
            "type": "string",
            "format": "uuid"
          },
          "dataFileId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "figmaFileKey",
          "figmaNodeId",
          "name",
          "width",
          "height",
          "imageFileId",
          "dataFileId"
        ],
        "additionalProperties": false
      },
      "CreateUploadDto": {
        "type": "object",
        "properties": {
          "clientRequestId": {
            "type": "string",
            "format": "uuid",
            "description": "Stable ID for retries of the same upload bundle."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "frames": {
            "minItems": 1,
            "description": "Ordered frames. File IDs must reference ready files in the same project; enforced by the future upload service.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FrameInputDto"
            }
          }
        },
        "required": [
          "clientRequestId",
          "name",
          "frames"
        ],
        "additionalProperties": false
      },
      "UploadFrameDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "figmaFileKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "figmaNodeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "width": {
            "type": "number",
            "minimum": 0.01
          },
          "height": {
            "type": "number",
            "minimum": 0.01
          },
          "imageFileId": {
            "type": "string",
            "format": "uuid"
          },
          "dataFileId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id",
          "figmaFileKey",
          "figmaNodeId",
          "name",
          "width",
          "height",
          "imageFileId",
          "dataFileId"
        ],
