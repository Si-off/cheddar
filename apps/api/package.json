{
  "name": "@cheddar/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p ../../packages/contracts/tsconfig.json && tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "typecheck": "tsc -p ../../packages/contracts/tsconfig.json && tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env.local dist/src/main.js",
    "dev": "pnpm build && pnpm start",
    "test": "pnpm --filter @cheddar/contracts build && node --env-file-if-exists=.env.local scripts/test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm build && node --env-file-if-exists=.env.local dist/scripts/migrate.js",
    "openapi:export": "pnpm build && node dist/scripts/export-openapi.js",
    "openapi:check": "pnpm build && node dist/scripts/export-openapi.js --check",
    "admin:create": "pnpm build && node --env-file-if-exists=.env.local dist/scripts/create-admin.js",
    "ai:costs:sync": "pnpm build && node --env-file-if-exists=.env.local dist/scripts/sync-ai-costs.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@cheddar/contracts": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/platform-ws": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/websockets": "12.1.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "openai": "7.38.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3"
  }
}
