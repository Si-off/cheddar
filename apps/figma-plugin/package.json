{
  "name": "@cheddar/figma-plugin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run --parallel \"/^watch:/\"",
    "watch:ui": "vite build --configLoader runner --watch",
    "watch:main": "vite build --configLoader runner --config vite.main.config.ts --mode development --watch",
    "dev:ui": "vite --configLoader runner",
    "dev:remote": "VITE_PLUGIN_UI_URL=http://localhost:5174 VITE_WEB_BASE_URL=http://127.0.0.1:5173 pnpm run --parallel \"/^(watch:main|dev:ui)$/\"",
    "build": "pnpm build:ui && vite build --configLoader runner --config vite.main.config.ts",
    "build:ui": "vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.main.json",
    "gen:api": "openapi-ts --no-log-file"
  },
  "dependencies": {
    "lucide-react": "1.56.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@tanstack/react-query": "5.104.2",
    "zustand": "5.0.15",
    "motion": "14.2.0",
    "@cheddar/ui": "workspace:*",
    "@cheddar/design-tokens": "workspace:*",
    "@cheddar/contracts": "workspace:*"
  },
  "devDependencies": {
    "vite": "7.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "24.19.2",
    "@hey-api/openapi-ts": "0.99.0",
    "@figma/plugin-typings": "1.141.0",
    "@figma/rest-api-spec": "0.45.0",
    "vite-plugin-singlefile": "2.3.3"
  }
}
